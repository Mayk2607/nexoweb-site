# ─── Sitio ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nexoweb.mx

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=notificaciones@nexoweb.mx
RESEND_TO=consultoria@nexoweb.mx

# ─── Notificaciones Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCDEFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# ─── Integración CRM (captación de leads) ────────────────────────────────────
# En Docker Compose (red interna): http://backend:3010
# En producción vía dominio público: https://api.nexoweb.mx
# NO incluir /api al final — la ruta se construye como {CRM_API_URL}/api/public/leads
CRM_API_URL=https://api.nexoweb.mx
CRM_INGEST_SECRET=tu_secret_compartido_con_el_backend

# ─── Base de datos (opcional — reservado para CMS futuro) ─────────────────────
# DATABASE_URL=postgresql://nexoweb:password@postgres:5432/nexoweb_site
